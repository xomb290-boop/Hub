-- ตรวจสอบว่าตัวละครกำลังกระโดดหรือลอยอยู่หรือไม่
local function isJumpingOrFalling(hum)
	if not hum then return false end
	local st = hum:GetState()
	return st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall
end

-- มุดดินให้ตัวลงไปเหลือโผล่แค่ขา โดยที่มุมมองของเรายังยึดกับตัวละครปกติและกระโดดได้
local rootJointMotor, origRootC0 = nil, nil
local savedHipHeight = nil
local savedPartCollide = {}
local appliedSinkActive = false

local function restoreBodySink()
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local cam = workspace.CurrentCamera

	if rootJointMotor and rootJointMotor.Parent and origRootC0 then
		rootJointMotor.C0 = origRootC0
	end
	if hum and savedHipHeight then
		hum.HipHeight = savedHipHeight
	end
	for part, canCol in pairs(savedPartCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = canCol
		end
	end
	if hum and cam and cam.CameraSubject ~= hum then
		cam.CameraSubject = hum
	end

	rootJointMotor, origRootC0 = nil, nil
	savedHipHeight = nil
	appliedSinkActive = false
	table.clear(savedPartCollide)
end

local function findRootJoint(character, root)
	if not character or not root then return nil end
	local rj = root:FindFirstChild("RootJoint")
	if rj and rj:IsA("Motor6D") then return rj end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 == root then
			return d
		end
	end
	return nil
end

local function applyBodySinkState()
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not c or not hum or not root or hum.Health <= 0 then
		restoreBodySink()
		return
	end

	if not cfg.bodySink then
		restoreBodySink()
		return
	end

	if not appliedSinkActive then
		savedHipHeight = hum.HipHeight
		for _, part in ipairs(c:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "LeftFoot" and part.Name ~= "RightFoot" then
				savedPartCollide[part] = part.CanCollide
				part.CanCollide = false
			end
		end
		-- ลด HipHeight เพียงครั้งเดียวตอนเปิดโหมด เพื่อไม่ให้รบกวนการกระโดด
		hum.HipHeight = math.max(0.2, savedHipHeight - cfg.sinkDepth)
		appliedSinkActive = true
	end

	local joint = findRootJoint(c, root)
	if joint then
		if rootJointMotor ~= joint then
			rootJointMotor = joint
			origRootC0 = joint.C0
		end
		joint.C0 = origRootC0 * CFrame.new(0, -0.75, 0)
	end
end

local function stepBodySink()
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local cam = workspace.CurrentCamera
	if not c or not hum or hum.Health <= 0 then
		restoreBodySink()
		return
	end

	if cam and cam.CameraSubject ~= hum then
		cam.CameraSubject = hum
	end

	if cfg.bodySink then
		applyBodySinkState()
	elseif appliedSinkActive then
		restoreBodySink()
	end
end

-- ฟังก์ชันกันล็อค (Anti-Lock): ขยับเฉพาะแนวราบ และไม่รบกวนตอนกระโดด
local antiLockToggle = false
local lastAntiLock = os.clock()
local lastAntiOffset = Vector3.zero

local function stepAntiLock()
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not c or not hum or not root or hum.Health <= 0 then
		lastAntiOffset = Vector3.zero
		return
	end

	if not cfg.antiLock or isJumpingOrFalling(hum) then
		if lastAntiOffset.Magnitude > 0 then
			root.CFrame = root.CFrame - lastAntiOffset
			lastAntiOffset = Vector3.zero
		end
		return
	end

	if os.clock() - lastAntiLock >= 0.05 then
		lastAntiLock = os.clock()
		antiLockToggle = not antiLockToggle

		if lastAntiOffset.Magnitude > 0 then
			root.CFrame = root.CFrame - lastAntiOffset
			lastAntiOffset = Vector3.zero
		end

		local sign = antiLockToggle and 1 or -1
		local jitter = Vector3.new(sign * 1.35, 0, -sign * 1.35)
		root.CFrame = root.CFrame + jitter
		lastAntiOffset = jitter
	end
end

-- หลบกระสุน: โยกซ้าย-ขวาแรงบนระนาบพื้น ไม่ลอยขึ้นฟ้าและไม่ขัดการกระโดด
local dodgeDir = 1
local lastFlip = os.clock()

local function stepDodge(cam)
	if not cfg.dodge or not cam then return end
	local c = player.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 or hum.SeatPart or isJumpingOrFalling(hum) then return end

	local threatened = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local eHum = p.Character:FindFirstChildOfClass("Humanoid")
			local eOrigin = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
			if eHum and eHum.Health > 0 and eOrigin then
				local diff = root.Position - eOrigin.Position
				local d = diff.Magnitude
				if d > 1 and d < 185 and eOrigin.CFrame.LookVector.Unit:Dot(diff.Unit) > 0.85 then
					threatened = true
					break
				end
			end
		end
	end

	if threatened then
		if os.clock() - lastFlip >= cfg.dodgeFlipRate then
			dodgeDir = -dodgeDir
			lastFlip = os.clock()
		end
		local r = cam.CFrame.RightVector
		local sideVec = Vector3.new(r.X, 0, r.Z)
		if sideVec.Magnitude > 0.01 then
			root.CFrame = root.CFrame + (sideVec.Unit * dodgeDir * cfg.dodgeStrafeStep)
		end
	end
end

